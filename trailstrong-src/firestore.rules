rules_version = '2';
// TrailStrong — chaque compte ne lit et n'écrit que ses propres données,
// et uniquement des documents qui ont la forme attendue par l'app
// (un bot connecté ne peut pas s'en servir pour stocker n'importe quoi).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function optString(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    // users/{uid} : profil, réglages, programme
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'profile', 'settings', 'program', 'onboarded', 'createdAt', 'updatedAt'])
        && optString(request.resource.data, 'email', 200)
        && optString(request.resource.data, 'name', 100)
        && optString(request.resource.data, 'photo', 1000)
        && (!('profile' in request.resource.data) || request.resource.data.profile is map)
        && (!('settings' in request.resource.data) || request.resource.data.settings is map)
        && (!('program' in request.resource.data) || request.resource.data.program == null || request.resource.data.program is map)
        && (!('onboarded' in request.resource.data) || request.resource.data.onboarded is bool);

      // days/{AAAA-MM-JJ} : séries, douleurs, tests, bilans du jour
      match /days/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['logs', 'checkin', 'tests', 'sessions', 'updatedAt'])
          && request.resource.data.updatedAt is number
          && (!('logs' in request.resource.data) || (request.resource.data.logs is map && request.resource.data.logs.size() <= 150))
          && (!('tests' in request.resource.data) || (request.resource.data.tests is map && request.resource.data.tests.size() <= 30))
          && (!('sessions' in request.resource.data) || (request.resource.data.sessions is map && request.resource.data.sessions.size() <= 10));
      }

      // custom/{custom-<horodatage>} : exercices ajoutés (photos comprises)
      match /custom/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && id.matches('^custom-[0-9]{10,16}$')
          && request.resource.data.keys().hasOnly([
            'id', 'name', 'target', 'protocol', 'rest', 'startWeight', 'tip', 'createdAt', 'source', 'catalogId',
            'tags', 'equipment', 'sets', 'reps', 'defaultReps', 'perSide', 'restS', 'mode', 'cadence', 'steps',
            'stepsLang', 'points', 'kneeAnkle', 'diagram', 'photos', 'video', 'sessionId'
          ])
          && request.resource.data.id == id
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.sessionId in ['activation', 'seanceA', 'seanceB', 'tapis']
          && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 2))
          && (!('steps' in request.resource.data) || (request.resource.data.steps is list && request.resource.data.steps.size() <= 12));
      }
    }

    // Tout le reste est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
